[Unit]
Description=Indian Stock Screener Dashboard
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/indian-screener
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/pi/indian-screener/.env
ExecStart=/home/pi/indian-screener/venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
